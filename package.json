{
  "name": "soundwave-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test:all": "npm run test:unit && npm run test:art && npm run test:integration",
    "uploads:cleanup": "tsx scripts/cleanup-uploads.ts",
    "uploads:remove": "tsx scripts/remove-recording.ts",
    "test:art": "tsx tests/test_art_engine.ts",
    "test:checkout": "tsx tests/test_curated_checkout.ts",
    "art:gallery": "tsx scripts/render-art.ts gallery docs/review/designs",
    "art:mockups": "tsx scripts/render-mockups.ts",
    "art:fonts": "node scripts/build-font-metrics.mjs",
    "test:qr": "python3 tests/test_qr_discreet.py",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "postinstall": "prisma generate",
    "test": "npm run test:unit && npm run test:art",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 --import ./tests/integration/setup.ts tests/integration/*.test.ts",
    "test:e2e": "tsx tests/e2e/checkout.e2e.ts",
    "test:db:prepare": "sh -c \"DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres@localhost:5433/soundwave_test} DIRECT_URL=${TEST_DATABASE_URL:-postgresql://postgres@localhost:5433/soundwave_test} prisma migrate deploy\"",
    "test:security": "tsx tests/e2e/security.e2e.ts",
    "release": "prisma migrate deploy && tsx prisma/seed.ts",
    "check:env": "tsx scripts/check-env.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@prisma/client": "^6.4.0",
    "@sentry/nextjs": "^11.1.0",
    "next": "16.1.6",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.6.2",
    "zod": "^4.6.5",
    "tsx": "^4.23.13",
    "prisma": "^6.4.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "opentype.js": "^1.3.4",
    "playwright-core": "1.56",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  }
}
