# SoundWave Art — Environment Configuration Template
# Copy this file to .env.local (and/or .env) and fill in your keys.
# In development, services degrade gracefully (mock mode) when keys are omitted.

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL / Supabase via Prisma)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ─────────────────────────────────────────────
# STRIPE (Required for live payments)
# Get keys at: https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ─────────────────────────────────────────────
# RESEND (Required for transactional order confirmation & shipping emails)
# Get free API key at: https://resend.com
# ─────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=orders@soundwaveart.com

# ─────────────────────────────────────────────
# PRINTIFY (Primary print partner for automated POD fulfillment)
# Get API key at: https://printify.com/app/settings/api
# ─────────────────────────────────────────────
PRINTIFY_API_KEY=REPLACE_ME
PRINTIFY_SHOP_ID=REPLACE_ME

# ─────────────────────────────────────────────
# PRODIGI (Secondary / backup fine-art print partner)
# https://www.prodigi.com/api/
# ─────────────────────────────────────────────
PRODIGI_API_KEY=REPLACE_ME

# ─────────────────────────────────────────────
# ETSY INTEGRATION (Optional — Sprint 2 external sync)
# ─────────────────────────────────────────────
ETSY_KEYSTRING=REPLACE_ME
ETSY_SHARED_SECRET=REPLACE_ME

# ─────────────────────────────────────────────
# APPLICATION CONFIG
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
