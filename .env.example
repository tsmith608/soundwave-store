# ─────────────────────────────────────────────────────────────────────────────
# SoundWave store — environment variables
# Copy to .env (never commit real values). Leave optional values empty.
# Validate with:  npm run check:env
# In development everything below "Required in production" can stay empty:
# the app uses local stand-ins (fake Stripe, mock print lab, file email,
# local storage). Production refuses to start without the real services.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # production: https://www.yourdomain.com (printed QR codes use it — decide before first order)
DATABASE_URL=postgresql://postgres@localhost:5432/soundwave   # pooled URL in production (e.g. ...?pgbouncer=true&connection_limit=5)
DIRECT_URL=postgresql://postgres@localhost:5432/soundwave     # direct (non-pooled) URL, used for migrations
APP_SECRET=                                 # production: 32+ random chars (openssl rand -base64 48). Signs order links, storage URLs.
ADMIN_EMAILS=                               # comma-separated emails allowed into /admin (sign in via emailed link)

# ── Site identity (public) ──────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=SoundWave Art
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_LEGAL_NAME=                     # OWNER: legal business name for Terms/Privacy
NEXT_PUBLIC_LEGAL_STATE=                    # OWNER: governing-law state, e.g. "Texas"
NEXT_PUBLIC_BUSINESS_ADDRESS=               # OWNER: optional; shown in email footers if set
ORDER_NUMBER_PREFIX=SW

# ── Payments: Stripe (Required in production) ───────────────────────────────
PAYMENTS_PROVIDER=                          # stripe | fake  (default: stripe if a key is set, else fake)
STRIPE_SECRET_KEY=                          # sk_test_... then sk_live_... (or a restricted key rk_...)
STRIPE_WEBHOOK_SECRET=                      # whsec_... from the webhook endpoint /api/webhooks/stripe
STRIPE_TAX_ENABLED=false                    # true after activating Stripe Tax + registrations
STRIPE_TAX_CODE=txcd_99999999               # product tax code for prints (confirm with your accountant)

# ── Storage: S3-compatible private bucket (Required in production) ───────────
STORAGE_DRIVER=local                        # local | s3
STORAGE_LOCAL_DIR=storage/objects
S3_BUCKET=
S3_REGION=auto                              # AWS: e.g. us-east-1 · Cloudflare R2: auto
S3_ENDPOINT=                                # R2: https://<account-id>.r2.cloudflarestorage.com · AWS: leave empty
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_ORIGIN=                      # optional override for the CSP (browser upload origin)
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false     # only with a persistent volume on a single server

# ── Print fulfillment: Prodigi (Required in production) ─────────────────────
FULFILLMENT_PROVIDER=                       # prodigi | mock  (default: prodigi if a key is set, else mock)
PRODIGI_API_KEY=
PRODIGI_ENV=sandbox                         # sandbox | live
PRODIGI_CALLBACK_SECRET=                    # 16+ random chars; appended to the callback URL we give Prodigi
PRODIGI_SHIPPING_METHOD=Standard            # Budget | Standard | Express | Overnight
FULFILLMENT_AUTO_SUBMIT=true                # false = orders wait in admin for a manual "Retry print / fulfillment"
FULFILLMENT_HOLD_HOURS=12                   # hours after payment before sending to the lab (typo-fix window promised in the confirmation email); 0 = immediately
SHIPPING_COUNTRIES=US
SHIPPING_EXPRESS_CENTS=                     # set (e.g. 1800) only after confirming express cost + times with Prodigi

# ── Email: Resend (Required in production) ───────────────────────────────────
EMAIL_PROVIDER=                             # resend | file  (default: resend if a key is set, else file → storage/emails)
RESEND_API_KEY=                             # re_...
EMAIL_FROM=                                 # "Your Brand <orders@yourdomain.com>" (domain verified in Resend)
EMAIL_REPLY_TO=                             # e.g. support@yourdomain.com
RESEND_WEBHOOK_SECRET=                      # whsec_... (optional: delivery/bounce tracking)

# ── Monitoring: Sentry (recommended) ────────────────────────────────────────
SENTRY_DSN=                                 # server + worker
NEXT_PUBLIC_SENTRY_DSN=                     # browser (can be the same DSN)
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=info

# ── Analytics (optional; first-party funnel works without these) ───────────
NEXT_PUBLIC_GA4_ID=                         # G-XXXXXXX
GA4_API_SECRET=                             # Measurement Protocol secret (server-side purchase)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_TOKEN=

# ── Worker / rendering ──────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
CHROMIUM_PATH=                              # auto-detected in the Docker image; set if rendering can't find Chromium
